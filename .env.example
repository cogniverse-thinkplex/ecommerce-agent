# Copy this file to .env and fill in local secrets.
# Do not commit .env.

# LiteLLM provider keys for tau2 text baseline.
# For OpenAI models such as openai/gpt-4.1 or openai/gpt-4.1-mini:
OPENAI_API_KEY=

# Optional if you choose Anthropic models through LiteLLM.
ANTHROPIC_API_KEY=

# Optional if you choose Alibaba Cloud Model Studio / DashScope models.
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# P0 baseline defaults used by scripts/run_tau2_retail_baseline.sh.
TAU2_AGENT_LLM=dashscope/deepseek-v4-pro-0813
TAU2_USER_LLM=dashscope/deepseek-v4-pro-0813
TAU2_NL_ASSERTIONS_LLM=dashscope/deepseek-v4-pro-0813
TAU2_ENV_INTERFACE_LLM=dashscope/deepseek-v4-pro-0813
# LiteLLM reports cost with a dollar symbol. These values convert the official
# Beijing/global busy-hour price of 9 CNY input and 27 CNY output per 1M tokens
# to an approximate USD/token rate using about 7.075 CNY/USD.
TAU2_DEEPSEEK_V4_PRO_0813_INPUT_COST_PER_TOKEN=0.000001272
TAU2_DEEPSEEK_V4_PRO_0813_OUTPUT_COST_PER_TOKEN=0.000003816
TAU2_NUM_TASKS=5
TAU2_NUM_TRIALS=1
TAU2_MAX_CONCURRENCY=1
TAU2_SAVE_TO=p0_retail_baseline

# Backend proposal generator.
# The customer product uses the LLM planner by default. Set "rule" only for
# deterministic tests or explicit troubleshooting; execution still goes
# through the deterministic policy guard.
ECOM_AGENT_STORE=sqlite
ECOM_AGENT_SQLITE_PATH=data/ecommerce_agent.db
ECOM_AGENT_TOOL_BACKEND=mcp
ECOM_AGENT_MCP_URL=http://127.0.0.1:8765/mcp
ECOM_AGENT_MCP_TIMEOUT_SECONDS=30
ECOM_AGENT_PROPOSAL_GENERATOR=llm
ECOM_AGENT_PROPOSAL_LLM=dashscope/qwen3.8-max
ECOM_AGENT_LLM_TIMEOUT_SECONDS=75
ECOM_AGENT_LLM_MAX_TOKENS=900

# Local product authentication. The initial SQL-seeded developer is
# admin@local.dev / Admin@123456 and must change the password on first login.
ECOM_AUTH_SESSION_HOURS=12
ECOM_AUTH_COOKIE_SECURE=false
ECOM_POLICY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ECOM_POLICY_MODEL_CACHE=data/models
ECOM_POLICY_MODEL_LOCAL_ONLY=true

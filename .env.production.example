# Copy to .env.production, set file mode 600, and provide secrets outside Git.
ECOM_ENV=production
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

ECOM_AGENT_STORE=sqlite
ECOM_AGENT_SQLITE_PATH=/app/data/ecommerce_agent.db
ECOM_AGENT_TOOL_BACKEND=mcp
ECOM_AGENT_MCP_URL=http://retail-mcp:8765/mcp
ECOM_AGENT_MCP_TIMEOUT_SECONDS=30
ECOM_AGENT_PROPOSAL_GENERATOR=llm
ECOM_AGENT_PROPOSAL_LLM=dashscope/qwen3.8-max
ECOM_AGENT_LLM_TIMEOUT_SECONDS=75
ECOM_AGENT_LLM_MAX_TOKENS=900

ECOM_AUTH_REQUIRED=true
ECOM_AUTH_SESSION_HOURS=12
ECOM_AUTH_COOKIE_SECURE=true
ECOM_LOGIN_MAX_FAILURES=5
ECOM_LOGIN_WINDOW_SECONDS=300
ECOM_LOGIN_BLOCK_SECONDS=900
ECOM_POLICY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ECOM_POLICY_MODEL_CACHE=/app/data/models
ECOM_POLICY_MODEL_LOCAL_ONLY=true

ECOM_BACKUP_DIR=/app/data/backups
ECOM_BACKUP_INTERVAL_SECONDS=86400
ECOM_BACKUP_RETENTION=14
ECOM_MAX_BACKUP_AGE_SECONDS=93600
ECOM_MIN_DISK_FREE_RATIO=0.20

